{
  "name": "devarab-ai-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI news ingestion + API subsystem for Dev Arab. Tracks official AI sources, verifies updates, and exposes bilingual (Arabic-first) JSON APIs.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "ingest": "tsx src/scripts/ingest-once.ts",
    "enrich": "tsx src/scripts/enrich-pending.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^11.2.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
