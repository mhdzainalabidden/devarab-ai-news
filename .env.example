# --- Database (PostgreSQL / Supabase) ---
# Use the Supabase "Connection string" (session pooler is fine for this workload).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devarab_ai_news
# Set to "true" when connecting to Supabase / managed PG that requires SSL.
DATABASE_SSL=false

# --- API server ---
# Note: the Dev Arab main web app commonly uses 3001 in dev; this subsystem
# defaults to 4010 to avoid a port collision.
PORT=4010
HOST=0.0.0.0
# Shared secret required by POST /api/admin/* endpoints (send as `x-admin-key` header).
ADMIN_API_KEY=change-me-please
# Allowed browser origins (comma-separated). "*" or empty = allow any (public read API).
# In production, restrict to your site, e.g. https://devarab.com,https://www.devarab.com
CORS_ORIGINS=*

# --- LLM (provider-agnostic, used for classification + bilingual summaries only, never as source of truth) ---
# Works with ANY OpenAI-compatible API. Leave all blank to run in heuristic fallback
# mode (items needing summaries are marked needs_review instead of published).
#
# Pick a provider by setting LLM_BASE_URL + LLM_API_KEY + LLM_MODEL:
#   OpenRouter (free): https://openrouter.ai/api/v1   model e.g. deepseek/deepseek-chat-v3-0324:free
#   Groq (free):       https://api.groq.com/openai/v1  model e.g. llama-3.3-70b-versatile
#   Gemini (free):     https://generativelanguage.googleapis.com/v1beta/openai  model e.g. gemini-2.5-flash
#   Ollama (local):    http://localhost:11434/v1        model e.g. qwen2.5  (no API key needed)
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
# Optional per-task model overrides (default to LLM_MODEL):
LLM_MODEL_CLASSIFY=
LLM_MODEL_SUMMARIZE=
LLM_REFERER=https://devarab.com
LLM_TITLE=Dev Arab AI News
# Cap LLM-enriched items per ingestion run (0 = unlimited). Protects free-tier daily limits.
LLM_MAX_ENRICH_PER_RUN=30
# Delay between LLM calls (ms) to stay under free-tier per-minute limits (0 = no delay).
LLM_MIN_INTERVAL_MS=4500

# Legacy/direct Anthropic (set this and leave LLM_BASE_URL empty to use Anthropic directly):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SUMMARIZE=claude-haiku-4-5-20251001

# --- GitHub (optional but recommended) — raises rate limits for releases/changelog fetching ---
GITHUB_TOKEN=

# --- Ingestion scheduler ---
# Cron expression for the hourly ingestion run. Default: top of every hour.
INGESTION_CRON=0 * * * *
# Set to "false" to disable the in-process scheduler (e.g. when using an external cron / Trigger.dev).
SCHEDULER_ENABLED=true
# Run a full ingestion pass once at startup.
RUN_INGESTION_ON_START=false

# --- Fetching behaviour ---
HTTP_USER_AGENT=DevArabAINewsBot/0.1 (+https://devarab.com; respects robots.txt)
HTTP_TIMEOUT_MS=15000
MAX_ITEMS_PER_SOURCE=15
RESPECT_ROBOTS_TXT=true

LOG_LEVEL=info
